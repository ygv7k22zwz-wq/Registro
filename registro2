    <script>
        // --- CONFIGURAZIONE FIREBASE CLOUD ---
        const firebaseConfig = {
            apiKey: "AIzaSyA9-5o_7GQmNosWQAWOI9CVnZxNTGOfld8",
            authDomain: "registro-9db0e.firebaseapp.com",
            databaseURL: "https://registro-9db0e-default-rtdb.europe-west1.firebasedatabase.app",
            projectId: "registro-9db0e",
            storageBucket: "registro-9db0e.firebasestorage.app",
            messagingSenderId: "961301993343",
            appId: "1:961301993343:web:bf9623c907091ad2146c4a"
        };
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        // --- SISTEMA DI LOGIN (Multi-Insegnante e Ricorda Password) ---
        let currentUserEmail = "";
        let utenteLoggato = null; // { nome, classi:[], materie:[], isAdmin }
        
        firebase.auth().onAuthStateChanged((user) => {
            if (user) {
                currentUserEmail = user.email;
                document.getElementById('login-overlay').style.display = 'none';
                if(db.classiAttive) applicaPermessi(); // Applica se DB è già carico
            } else {
                document.getElementById('login-overlay').style.display = 'flex';
            }
        });

        function effettuaLogin() {
            let user = document.getElementById('login-username').value.trim();
            let pass = document.getElementById('login-password').value;
            let errorText = document.getElementById('login-error');
            if(!user || !pass) return errorText.innerText = "⚠️ Inserisci credenziali.";
            
            let email = user.includes('@') ? user : user + "@registro.com";
            let pers = document.getElementById('ricorda-pwd').checked ? firebase.auth.Auth.Persistence.LOCAL : firebase.auth.Auth.Persistence.SESSION;
            errorText.innerText = "Connessione in corso...";

            firebase.auth().setPersistence(pers).then(() => {
                return firebase.auth().signInWithEmailAndPassword(email, pass);
            }).catch((error) => {
                errorText.innerText = "❌ Errore: Credenziali errate.";
            });
        }

        function effettuaRegistrazione() {
            let user = document.getElementById('login-username').value.trim();
            let pass = document.getElementById('login-password').value;
            let errorText = document.getElementById('login-error');
            if(!user || !pass) return errorText.innerText = "⚠️ Inserisci l'email o il nome utente e una password sicura prima di cliccare su Registrati.";
            
            let email = user.includes('@') ? user : user + "@registro.com";
            errorText.innerText = "Registrazione in corso...";
            
            firebase.auth().createUserWithEmailAndPassword(email, pass).then(() => {
                alert("Account Creato! Ora puoi accedere liberamente alle tue classi.");
            }).catch((error) => {
                errorText.innerText = "❌ Errore registrazione: " + error.message;
            });
        }

        function effettuaLogout() { firebase.auth().signOut().then(() => location.reload()); }

        // --- GESTIONE DATABASE E CLASSI ---
        let db = { classiAttive: ["Classe Unica"], studentiPerClasse: {}, materie: [], presenze: {}, orariPresenza: {}, infoAppello: {}, giustificazioni: {}, voti: [], attivita: [], compiti: [], note: [], comunicazioni: [], pagelle: [], insegnanti: {} };
        let paginaAttiva = 'dashboard';
        let oggiStr = new Date().toISOString().split('T')[0];
        let classeCorrente = "Classe Unica";

        let studDaGiustificareCorrente = ""; let indiceVotoDaEliminare = -1;
        let editIdxVoto = -1; let editIdxAtt = -1; let editIdxComp = -1; let editIdxNota = -1; let editIdxCom = -1;
        let bozzaPagella = { titolo: '', voti: {}, ammessi: {} }; let materiaPagellaCorrente = '';
        let isModalitaMultipla = false; let isModalitaClasse = false; let studCorrenteVotoSingolo = "";

        database.ref('registroDati').on('value', (snapshot) => {
            const datiCloud = snapshot.val();
            if (datiCloud) {
                db.classiAttive = datiCloud.classiAttive || ["Classe Unica"];
                db.studentiPerClasse = datiCloud.studentiPerClasse || { "Classe Unica": (datiCloud.studenti || []) };
                db.materie = datiCloud.materie || [];
                db.presenze = datiCloud.presenze || {};
                db.orariPresenza = datiCloud.orariPresenza || {};
                db.infoAppello = datiCloud.infoAppello || {};
                db.giustificazioni = datiCloud.giustificazioni || {};
                db.insegnanti = datiCloud.insegnanti || {};
                
                // Fix di sicurezza Firebase: Garantisce che gli array non vengano trasformati in oggetti in caso di cancellazioni
                db.voti = Array.isArray(datiCloud.voti) ? datiCloud.voti : Object.values(datiCloud.voti || {});
                db.attivita = Array.isArray(datiCloud.attivita) ? datiCloud.attivita : Object.values(datiCloud.attivita || {});
                db.compiti = Array.isArray(datiCloud.compiti) ? datiCloud.compiti : Object.values(datiCloud.compiti || {});
                db.note = Array.isArray(datiCloud.note) ? datiCloud.note : Object.values(datiCloud.note || {});
                db.comunicazioni = Array.isArray(datiCloud.comunicazioni) ? datiCloud.comunicazioni : Object.values(datiCloud.comunicazioni || {});
                db.pagelle = Array.isArray(datiCloud.pagelle) ? datiCloud.pagelle : Object.values(datiCloud.pagelle || {});
                
                for(let s in db.giustificazioni) if(!Array.isArray(db.giustificazioni[s])) db.giustificazioni[s] = Object.values(db.giustificazioni[s] || {});
            } else {
                salvaDB();
            }

            document.getElementById('sync-status').innerText = "✅ Cloud Sincronizzato";
            document.getElementById('sync-status').classList.add('status-ok');
            
            if(currentUserEmail) applicaPermessi();
        });

        function applicaPermessi() {
            if(!currentUserEmail) return;
            let emailKey = currentUserEmail.replace(/\./g, ',');
            let info = db.insegnanti[emailKey];

            if(!info) {
                // Sblocco automatico: chi non è specificamente limitato dal pannello, ha pieni poteri per non restare bloccato fuori
                utenteLoggato = { nome: currentUserEmail, classi: [...(db.classiAttive || [])], materie: [...(db.materie || [])], isAdmin: true };
            } else {
                utenteLoggato = info; 
                utenteLoggato.isAdmin = currentUserEmail.startsWith('admin') || info.isAdmin;
            }

            let sel = document.getElementById('selettore-classe');
            if(sel) {
                sel.innerHTML = utenteLoggato.classi.map(c => `<option value="${c}">${c}</option>`).join('');
                if(utenteLoggato.classi.length > 0) {
                    if(!utenteLoggato.classi.includes(classeCorrente)) classeCorrente = utenteLoggato.classi[0];
                    sel.value = classeCorrente;
                }
            }
            document.getElementById('pannello-admin').style.display = utenteLoggato.isAdmin ? 'block' : 'none';
            aggiornaSchermataAttiva();
        }

        function salvaDB() {
            document.getElementById('sync-status').innerText = "Caricamento... ⏳";
            document.getElementById('sync-status').classList.remove('status-ok');
            database.ref('registroDati').set(db);
        }

        function cambiaClasseCorrente(val) { classeCorrente = val; aggiornaSchermataAttiva(); }
        function toggleSidebar() { document.getElementById('sidebar').classList.toggle('nascosta'); document.getElementById('main-content').classList.toggle('allargato'); }
        function chiudiModal(id) { document.getElementById(id).classList.remove('active'); }

        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('dataGlobale').value = oggiStr;
            document.querySelectorAll('input[type="date"]').forEach(el => el.value = oggiStr);
            if(window.innerWidth < 800) toggleSidebar(); 
        });

        function cambiaDataGlobale(val) { oggiStr = val; document.querySelectorAll('input[type="date"]').forEach(el => { if(el.id !== 'rinominaPagella') el.value = oggiStr; }); aggiornaSchermataAttiva(); }

        function cambiaPagina(id, btn) {
            paginaAttiva = id; isModalitaClasse = false;
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            if(btn) { document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active'); }
            document.getElementById('page-'+id).classList.add('active');
            aggiornaSchermataAttiva();
            if(window.innerWidth < 800 && btn) toggleSidebar();
        }

        function aggiornaSchermataAttiva() {
            if(!classeCorrente && !utenteLoggato?.isAdmin) return;
            if(paginaAttiva==='dashboard') caricaDashboard();
            if(paginaAttiva==='presenze') caricaAppello();
            if(paginaAttiva==='voti' || paginaAttiva==='dettaglio-voti') { if(paginaAttiva==='voti') caricaGrigliaVoti(); else apriMateriaVoti(window.materiaCorrente); }
            if(paginaAttiva==='attivita' || paginaAttiva==='compiti') aggiornaSelectMaterie();
            if(paginaAttiva==='note') caricaNote();
            if(paginaAttiva==='comunicazioni') caricaComunicazioni();
            if(paginaAttiva==='crea-pagella') caricaGrigliaMateriePagella();
            if(paginaAttiva==='pagelle') caricaArchivioPagelle();
            if(paginaAttiva==='config') caricaConfig();
        }

        function calcolaColore(voto, faMedia) {
            if (voto === 'A') return 'voto-A';
            if (voto === 'IMP') return 'voto-IMP';
            if (faMedia === false) return 'voto-no-media';
            let num = parseFloat(voto);
            if (isNaN(num)) return 'voto-rosso';
            return num >= 6 ? 'voto-verde' : 'voto-rosso';
        }

        function getEventiDaGiustificare(st) { let ev=[]; let giaG = Array.isArray(db.giustificazioni[st])?db.giustificazioni[st]:[]; for(let d in db.presenze){ let s=db.presenze[d][st]; if((s==='Assente'||s==='Ritardo'||s==='Uscito')&&!giaG.includes(d)) ev.push({data:d, stato:s}); } return ev.sort((a,b)=>new Date(b.data)-new Date(a.data)); }
        function getStatisticheStudente(st) { let ass=0, rit=0, usc=0; for(let d in db.presenze){ if(db.presenze[d][st]==='Assente') ass++; if(db.presenze[d][st]==='Ritardo') rit++; if(db.presenze[d][st]==='Uscito') usc++; } return {assenze:ass, ritardi:rit, uscite:usc}; }

        function caricaDashboard() {
            let studentiClasse = db.studentiPerClasse[classeCorrente] || [];
            document.getElementById('dataGlobale').value = oggiStr;
            document.getElementById('dash-data-oggi').innerText = oggiStr.split('-').reverse().join('/');
            
            let htmlStato = [];
            if(db.presenze[oggiStr]) {
                studentiClasse.forEach(st => {
                    let s = db.presenze[oggiStr][st];
                    if(s && s !== 'Presente') {
                        let ore = (db.orariPresenza && db.orariPresenza[oggiStr] && db.orariPresenza[oggiStr][st]) ? ` (${db.orariPresenza[oggiStr][st]})` : '';
                        if(s==='Assente') htmlStato.push(`<li><span style="color:var(--t-assente);font-weight:bold;">🔴 Assente: ${st}</span></li>`); 
                        else if(s==='Uscito') htmlStato.push(`<li><span style="color:var(--t-uscito);font-weight:bold;">🔵 Uscito: ${st}</span>${ore}</li>`); 
                        else if(s==='Ritardo') htmlStato.push(`<li><span style="color:var(--t-ritardo);font-weight:bold;">🟠 Ritardo: ${st}</span>${ore}</li>`);
                    }
                });
            }
            document.getElementById('dash-assenti').innerHTML = htmlStato.length ? htmlStato.join('') : '<li style="color:var(--text-muted);">Tutti presenti.</li>';
            
            let materieVisibili = utenteLoggato?.isAdmin ? db.materie : utenteLoggato?.materie || [];
            let c = db.compiti.filter(x=>x.data===oggiStr && materieVisibili.includes(x.materia)); document.getElementById('dash-compiti').innerHTML = c.length ? c.map(x=>`<li><b>${x.materia}:</b> ${x.testo}</li>`).join('') : '<li>Nessun compito oggi.</li>';
            let att = db.attivita.filter(x=>x.data===oggiStr && materieVisibili.includes(x.materia)); document.getElementById('dash-attivita').innerHTML = att.length ? att.map(x=>`<li><b>${x.materia}:</b> ${x.testo}</li>`).join('') : '<li>Nessuna attività registrata.</li>';
            
            let hGiust = []; studentiClasse.forEach(st=>{ let ev=getEventiDaGiustificare(st); if(ev.length>0) hGiust.push(`<li><span style="color:#fb923c;">⚠️ <b>${st}</b>: ${ev.length} eventi da giust.</span></li>`); });
            document.getElementById('dash-giustificazioni').innerHTML = hGiust.length ? hGiust.join('') : '<li style="color:#10b981;">Tutto giustificato.</li>';
            
            let coms = [...db.comunicazioni].filter(c => c.classe === classeCorrente || !c.classe).sort((a,b)=>new Date(b.data)-new Date(a.data)).slice(0,3); 
            document.getElementById('dash-comunicazioni').innerHTML = coms.length ? coms.map(x=>`<b>${x.titolo}</b> (${x.data})<br><span style="font-size:12px;">${x.testo}</span><br>`).join('<hr style="border-color:#262626; margin:5px 0;">') : 'Nessuna comunicazione.';
        }

        // --- GESTIONE IMPOSTAZIONI, CLASSI E INSEGNANTI ---
        function caricaConfig() {
            document.getElementById('lista-classi').innerHTML = db.classiAttive.map(c => `<span class="voto-item" style="background:#1c1c1f;">${c} <b onclick="if(confirm('Rimuovere classe? I dati resteranno orfani.')) { db.classiAttive.splice(db.classiAttive.indexOf('${c}'),1); salvaDB(); caricaConfig(); }" style="color:#ef4444; margin-left:5px;">X</b></span>`).join('');
            
            let selC = document.getElementById('config-sel-classe');
            if(selC) { selC.innerHTML = db.classiAttive.map(c => `<option value="${c}">${c}</option>`).join(''); caricaListaStudentiConfig(); }

