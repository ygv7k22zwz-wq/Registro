            let studentiClasse = db.studentiPerClasse[classeCorrente] || [];
            document.getElementById('noteCheckboxes').innerHTML = studentiClasse.map(s => `<label class="checkbox-item"><input type="checkbox" class="check-nota-stud" value="${s}"> ${s}</label>`).join(''); 
            let tb = document.getElementById('tabellaNote'); tb.innerHTML = ''; 
            db.note.map((n,i)=>({...n, idx:i})).filter(n => studentiClasse.includes(n.studente)).sort((a,b)=> new Date(b.data) - new Date(a.data)).forEach((n) => { 
                tb.innerHTML += `<tr><td>${n.data.split('-').reverse().join('/')}</td><td><b>${n.studente}</b></td><td>${n.tipo}</td><td>${n.testo}</td><td><button class="btn-cestino" onclick="preparaModificaNota(${n.idx})">✏️</button> <button class="btn-cestino" onclick="if(confirm('Eliminare nota?')) { db.note.splice(${n.idx},1); salvaDB(); caricaNote(); }">🗑️</button></td></tr>`; 
            }); 
        }
        function preparaModificaNota(idx) { let n = db.note[idx]; editIdxNota = idx; document.querySelectorAll('.check-nota-stud').forEach(cb => cb.checked = (cb.value === n.studente)); document.getElementById('notaTipo').value = n.tipo; document.getElementById('notaData').value = n.data; document.getElementById('notaTesto').value = n.testo; document.querySelector('#page-note .btn-danger').innerText = "Aggiorna Nota"; }
        function selezionaTuttiNote(checked) { document.querySelectorAll('.check-nota-stud').forEach(cb => cb.checked = checked); }
        function salvaNota() { let t = document.getElementById('notaTesto').value; let sel = Array.from(document.querySelectorAll('.check-nota-stud:checked')).map(cb => cb.value); if(sel.length===0) return alert("Seleziona studente!"); if(!t) return alert("Motivazione mancante."); let d = document.getElementById('notaData').value, tip = document.getElementById('notaTipo').value; if(editIdxNota >= 0) { db.note[editIdxNota] = {studente: sel[0], tipo: tip, data: d, testo: t}; editIdxNota = -1; document.querySelector('#page-note .btn-danger').innerText = "Salva Nota"; } else { sel.forEach(s => db.note.push({studente: s, tipo: tip, data: d, testo: t})); } salvaDB(); caricaNote(); document.getElementById('notaTesto').value=''; }
        
        function gestisciTargetComunicazione(val) { document.getElementById('comStudente').style.display = val === 'Singolo Studente' ? 'inline-block' : 'none'; document.getElementById('comPiuStudenti').style.display = val === 'Più Studenti' ? 'grid' : 'none'; }
        function caricaComunicazioni() { 
            let tb = document.getElementById('tabellaComunicazioni'); tb.innerHTML = ''; let studentiClasse = db.studentiPerClasse[classeCorrente] || [];
            document.getElementById('comStudente').innerHTML = studentiClasse.map(s => `<option value="${s}">${s}</option>`).join('');
            document.getElementById('comPiuStudenti').innerHTML = studentiClasse.map(s => `<label class="checkbox-item"><input type="checkbox" class="check-com-stud" value="${s}"> ${s}</label>`).join('');
            db.comunicazioni.map((c,i)=>({...c, idx:i})).filter(c => c.classe === classeCorrente || !c.classe).sort((a,b)=> new Date(b.data) - new Date(a.data)).forEach((c) => { 
                tb.innerHTML += `<tr><td><b>${c.data.split('-').reverse().join('/')}</b><br><span style="color:var(--accent-purple);">${c.titolo}</span><br><span style="font-size:12px; color:var(--accent-cyan);">Destinatario: ${c.target || 'Classe'}</span><br><span style="font-size:13px; color:var(--text-muted);">${c.testo}</span></td><td><button class="btn-cestino" onclick="preparaModificaComunicazione(${c.idx})">✏️</button> <button class="btn-cestino" onclick="if(confirm('Eliminare?')){db.comunicazioni.splice(${c.idx},1); salvaDB(); caricaComunicazioni();}">🗑️</button></td></tr>`; 
            }); 
        }
        function preparaModificaComunicazione(idx) { let c = db.comunicazioni[idx]; editIdxCom = idx; document.getElementById('comTitolo').value = c.titolo; document.getElementById('comData').value = c.data; document.getElementById('comTesto').value = c.testo; let tgt = c.target || 'Classe'; if(tgt.startsWith('Alunno: ')) { document.getElementById('comTarget').value = 'Singolo Studente'; gestisciTargetComunicazione('Singolo Studente'); document.getElementById('comStudente').value = tgt.replace('Alunno: ', ''); } else if (tgt.startsWith('Alunni: ')) { document.getElementById('comTarget').value = 'Più Studenti'; gestisciTargetComunicazione('Più Studenti'); let studList = tgt.replace('Alunni: ', '').split(', '); document.querySelectorAll('.check-com-stud').forEach(cb => { cb.checked = studList.includes(cb.value); }); } else { document.getElementById('comTarget').value = tgt; gestisciTargetComunicazione(tgt); } document.querySelector('#page-comunicazioni .btn').innerText = "Aggiorna"; }
        function salvaComunicazione() { let t = document.getElementById('comTitolo').value, txt = document.getElementById('comTesto').value; if(!t||!txt) return; let target = document.getElementById('comTarget').value; if(target === 'Singolo Studente') { target = "Alunno: " + document.getElementById('comStudente').value; } else if (target === 'Più Studenti') { let sel = Array.from(document.querySelectorAll('.check-com-stud:checked')).map(cb => cb.value); if(sel.length === 0) return alert("Seleziona almeno uno studente!"); target = "Alunni: " + sel.join(', '); } if(editIdxCom >= 0) { db.comunicazioni[editIdxCom] = {titolo:t, data:document.getElementById('comData').value, testo:txt, target: target, classe: classeCorrente}; editIdxCom = -1; document.querySelector('#page-comunicazioni .btn').innerText = "Pubblica"; } else { db.comunicazioni.push({titolo:t, data:document.getElementById('comData').value, testo:txt, target: target, classe: classeCorrente}); } salvaDB(); caricaComunicazioni(); document.getElementById('comTitolo').value=''; document.getElementById('comTesto').value=''; document.getElementById('comTarget').value='Classe'; gestisciTargetComunicazione('Classe'); document.querySelectorAll('.check-com-stud').forEach(cb => cb.checked=false); }
        
        function aggiornaSelectMaterie() { let materieVisibili = utenteLoggato?.isAdmin ? db.materie : utenteLoggato?.materie || []; let mHtml = materieVisibili.map(m => `<option value="${m}">${m}</option>`).join(''); ['attivitaMateria', 'filtroAttivita', 'compitiMateria', 'filtroCompiti'].forEach(id => { let el = document.getElementById(id); if(el) { let val = el.value; el.innerHTML = '<option value="" disabled selected>Materia...</option>' + mHtml; if(materieVisibili.includes(val)) el.value = val; } }); caricaRegistroAttivita(); caricaRegistroCompiti(); }
        function preparaModificaAttivita(idx) { let a = db.attivita[idx]; editIdxAtt = idx; document.getElementById('attivitaMateria').value = a.materia; document.getElementById('attivitaData').value = a.data; document.getElementById('attivitaTesto').value = a.testo; document.querySelector('#page-attivita .btn').innerText = "Aggiorna"; }
        function salvaAttivita() { let m=document.getElementById('attivitaMateria').value, t = document.getElementById('attivitaTesto').value.trim(); if(!t||!m) return; if(editIdxAtt >= 0) { db.attivita[editIdxAtt] = { materia:m, data:document.getElementById('attivitaData').value, testo:t }; editIdxAtt = -1; document.querySelector('#page-attivita .btn').innerText = "Registra"; } else { db.attivita.push({ materia:m, data:document.getElementById('attivitaData').value, testo:t }); } salvaDB(); document.getElementById('attivitaTesto').value=''; caricaRegistroAttivita(); }
        function caricaRegistroAttivita() { let m = document.getElementById('filtroAttivita').value, tb = document.getElementById('tabellaStoricoAttivita'); tb.innerHTML=''; db.attivita.map((a,i)=>({...a, idx:i})).filter(a=>a.materia===m).sort((a,b)=>new Date(b.data)-new Date(a.data)).forEach(a => tb.innerHTML += `<tr><td>${a.data.split('-').reverse().join('/')}</td><td>${a.testo}</td><td><button class="btn-cestino" onclick="preparaModificaAttivita(${a.idx})">✏️</button> <button class="btn-cestino" onclick="if(confirm('Eliminare?')){db.attivita.splice(${a.idx},1); salvaDB(); caricaRegistroAttivita();}">🗑️</button></td></tr>`); }
        function preparaModificaCompito(idx) { let c = db.compiti[idx]; editIdxComp = idx; document.getElementById('compitiMateria').value = c.materia; document.getElementById('compitiData').value = c.data; document.getElementById('compitiTesto').value = c.testo; document.querySelector('#page-compiti .btn').innerText = "Aggiorna"; }
        function salvaCompiti() { let m=document.getElementById('compitiMateria').value, t = document.getElementById('compitiTesto').value.trim(); if(!t||!m) return; if(editIdxComp >= 0) { db.compiti[editIdxComp] = { materia:m, data:document.getElementById('compitiData').value, testo:t }; editIdxComp = -1; document.querySelector('#page-compiti .btn').innerText = "Assegna"; } else { db.compiti.push({ materia:m, data:document.getElementById('compitiData').value, testo:t }); } salvaDB(); document.getElementById('compitiTesto').value=''; caricaRegistroCompiti(); }
        function caricaRegistroCompiti() { let m = document.getElementById('filtroCompiti').value, tb = document.getElementById('tabellaStoricoCompiti'); tb.innerHTML=''; db.compiti.map((c,i)=>({...c, idx:i})).filter(c=>c.materia===m).sort((a,b)=>new Date(b.data)-new Date(a.data)).forEach(c => tb.innerHTML += `<tr><td>${c.data.split('-').reverse().join('/')}</td><td>${c.testo}</td><td><button class="btn-cestino" onclick="preparaModificaCompito(${c.idx})">✏️</button> <button class="btn-cestino" onclick="if(confirm('Eliminare?')){db.compiti.splice(${c.idx},1); salvaDB(); caricaRegistroCompiti();}">🗑️</button></td></tr>`); }

        function inizializzaBozzaPagella() { let studentiClasse = db.studentiPerClasse[classeCorrente] || []; if(!bozzaPagella.voti) bozzaPagella.voti={}; if(!bozzaPagella.ammessi) bozzaPagella.ammessi={}; studentiClasse.forEach(s=>{ if(bozzaPagella.ammessi[s]===undefined) bozzaPagella.ammessi[s]=true; }); document.getElementById('pagellaTitolo').value = bozzaPagella.titolo; }
        function resetBozzaPagella() { if(confirm("Vuoi azzerare la bozza attuale?")) { bozzaPagella = {titolo:'', voti:{}, ammessi:{}}; document.getElementById('pagellaTitolo').value=''; caricaGrigliaMateriePagella(); } }
        function caricaGrigliaMateriePagella() { let materieVisibili = utenteLoggato?.isAdmin ? db.materie : utenteLoggato?.materie || []; inizializzaBozzaPagella(); let grid = document.getElementById('grigliaMateriePagella'); grid.innerHTML = ''; let studentiClasse = db.studentiPerClasse[classeCorrente] || []; materieVisibili.forEach(m => { let comp = true; if(!bozzaPagella.voti[m]) comp=false; else { studentiClasse.forEach(s=>{ if(!bozzaPagella.voti[m][s]||bozzaPagella.voti[m][s].trim()==="") comp=false; }); } let st = comp?"border: 2px solid var(--voto-suff); box-shadow: 0 0 10px rgba(74, 222, 128, 0.2); background: #15241b;":""; let txt = comp?'✅ Completata':'⏳ Da compilare'; grid.innerHTML += `<div class="card-materia" style="${st}" onclick="apriCompilaMateriaPagella('${m}')">${m}<br><span style="font-size:12px; font-weight:normal; color:var(--text-muted); display:inline-block; margin-top:5px;">${txt}</span></div>`; }); }
        function apriCompilaMateriaPagella(m) { materiaPagellaCorrente = m; document.getElementById('titoloCompilaMateriaPagella').innerText = "Pagella: " + m; let tb = document.getElementById('corpoCompilaMateriaPagella'); tb.innerHTML = ''; let studentiClasse = db.studentiPerClasse[classeCorrente] || []; if(!bozzaPagella.voti[m]) bozzaPagella.voti[m] = {}; studentiClasse.forEach(s => { let vv = db.voti.filter(v => v.materia===m && v.studente===s && v.faMedia!==false && !isNaN(parseFloat(v.voto))); let med = vv.length?(vv.reduce((acc,c)=>acc+parseFloat(c.voto),0)/vv.length).toFixed(2):'-'; let v = bozzaPagella.voti[m][s] || ''; tb.innerHTML += `<tr><td><b style="font-size:15px;">${s}</b></td><td style="color:var(--accent-cyan); font-weight:bold; font-size:16px;">${med}</td><td><input type="number" id="pagella_draft_voto_${s}" min="1" max="10" step="0.5" value="${v}" placeholder="Voto" style="max-width:120px; margin:0; font-weight:bold;" oninput="if(this.value > 10) this.value = 10;"></td></tr>`; }); cambiaPagina('compila-materia-pagella'); }
        function importaVotiMediaMateria() { let m = materiaPagellaCorrente; let modificati = 0; let studentiClasse = db.studentiPerClasse[classeCorrente] || []; studentiClasse.forEach(s => { let vv = db.voti.filter(v => v.materia === m && v.studente === s && v.faMedia !== false && !isNaN(parseFloat(v.voto))); if (vv.length > 0) { let media = (vv.reduce((acc, c) => acc + parseFloat(c.voto), 0) / vv.length).toFixed(1); let mediaArrotondata = Math.round(media * 2) / 2; let input = document.getElementById(`pagella_draft_voto_${s}`); if (input) { input.value = mediaArrotondata; modificati++; } } }); if (modificati > 0) alert(`Importati ${modificati} voti calcolati dalla media!`); else alert("Nessun voto calcolabile in questa materia."); }
        function salvaMateriaPagella() { let m = materiaPagellaCorrente; let studentiClasse = db.studentiPerClasse[classeCorrente] || []; if(!bozzaPagella.voti[m]) bozzaPagella.voti[m]={}; studentiClasse.forEach(s=>{ let val=document.getElementById(`pagella_draft_voto_${s}`).value; if(val) bozzaPagella.voti[m][s]=val; else delete bozzaPagella.voti[m][s]; }); cambiaPagina('crea-pagella'); }
        function apriRiepilogoPagella() { bozzaPagella.titolo = document.getElementById('pagellaTitolo').value.trim(); if(!bozzaPagella.titolo) return alert("Inserisci un nome per la pagella prima di procedere!"); let list = document.getElementById('listaAmmissioniPagella'); list.innerHTML = ''; let studentiClasse = db.studentiPerClasse[classeCorrente] || []; studentiClasse.forEach(s => { let ck = bozzaPagella.ammessi[s]!==false; let col = ck?'var(--text-light)':'var(--voto-insuff)'; list.innerHTML += `<label class="checkbox-item" style="padding:12px; border:1px solid var(--border-color); border-radius:8px; background:#1c1c1f;"><input type="checkbox" id="ammesso_draft_${s}" ${ck?'checked':''} onchange="this.nextElementSibling.style.color=this.checked?'var(--text-light)':'var(--voto-insuff)'"><b style="font-size:15px; color:${col}; transition:0.2s;">${s}</b></label>`; }); cambiaPagina('riepilogo-pagella'); }
        function pubblicaPagellaDefinitiva() { let studentiClasse = db.studentiPerClasse[classeCorrente] || []; studentiClasse.forEach(s=>bozzaPagella.ammessi[s]=document.getElementById(`ammesso_draft_${s}`).checked); if(confirm("Pubblicare definitivamente la pagella?")) { db.pagelle.push({ titolo:bozzaPagella.titolo, data:oggiStr, voti:bozzaPagella.voti, ammessi:bozzaPagella.ammessi, classe: classeCorrente }); salvaDB(); alert("Pagella Pubblicata!"); bozzaPagella={titolo:'', voti:{}, ammessi:{}}; document.getElementById('pagellaTitolo').value=''; cambiaPagina('pagelle', document.getElementById('btn-pagelle')); } }
        function caricaArchivioPagelle() { let list = document.getElementById('listaPagelleSalvate'); list.innerHTML = ''; let filtrate = db.pagelle.filter(p => !p.classe || p.classe === classeCorrente); if(filtrate.length===0) return list.innerHTML='<p style="color:var(--text-muted)">Nessuna pagella per questa classe.</p>'; db.pagelle.forEach((p, i) => { if(p.classe && p.classe !== classeCorrente) return; let info = p.classe ? `Classe: ${p.classe} | ` : `Pagella | `; list.innerHTML += `<div style="background:#18181b; padding:15px; border-radius:8px; border:1px solid var(--border-color); margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;"><div><h4 style="color:var(--accent-purple); margin-bottom:5px; font-size:16px;">${p.titolo}</h4><span style="font-size:12px; color:var(--text-muted);">${info}Data: ${p.data.split('-').reverse().join('/')}</span></div><div><button class="btn btn-small" onclick="apriPagellaArchivio(${i})">Apri</button><button class="btn-cestino" style="color:#ef4444;" onclick="seEliminaPagella(${i})">🗑️</button></div></div>`; }); }
        function seEliminaPagella(idx) { if(confirm("Eliminare definitivamente?")) { db.pagelle.splice(idx,1); salvaDB(); caricaArchivioPagelle(); } }
        function apriPagellaArchivio(idx) { window.pagellaCorrenteIdx = idx; let p = db.pagelle[idx]; document.getElementById('titoloPagellaAperta').innerText = p.titolo; document.getElementById('rinominaPagella').value = p.titolo; let divCorpo = document.getElementById('corpoTabellaPagellaAperta'); divCorpo.innerHTML = ''; let studentiPagella = p.ammessi ? Object.keys(p.ammessi) : (p.voti && Object.keys(p.voti).length ? Object.keys(p.voti[Object.keys(p.voti)[0]]) : []); studentiPagella.sort().forEach(s => { let amm = true; if(p.ammessi && p.ammessi[s]===false) amm=false; let col = amm?'var(--text-light)':'var(--voto-insuff)', lab = amm?'<span style="color:var(--voto-suff); font-size:12px; font-weight:normal;">(Ammesso)</span>':'<span style="color:var(--voto-insuff); font-size:12px; font-weight:bold;">(NON AMMESSO)</span>'; divCorpo.innerHTML += `<div class="card-studente-archivio" onclick="apriVotiStudentePagella(${idx}, '${s}')"><b style="color:${col}; font-size: 16px;">${s} ${lab}</b><span style="color:var(--accent-cyan); font-weight:bold; font-size:14px;">Voti ➡️</span></div>`; }); document.querySelectorAll('.page').forEach(el=>el.classList.remove('active')); document.getElementById('page-dettaglio-pagella').classList.add('active'); paginaAttiva='dettaglio-pagella'; }
        function aggiornaNomePagella() { let nuovo = document.getElementById('rinominaPagella').value.trim(); if(nuovo) { db.pagelle[window.pagellaCorrenteIdx].titolo=nuovo; salvaDB(); document.getElementById('titoloPagellaAperta').innerText=nuovo; alert("Rinominata!"); } }
        function apriVotiStudentePagella(idx, stud) { let p = db.pagelle[idx]; document.getElementById('titoloVotiStudentePagella').innerText = `Voti Finali: ${stud} (${p.titolo})`; let tb = document.getElementById('corpoVotiStudentePagella'); tb.innerHTML = ''; if(p.voti) { let mat = Object.keys(p.voti); if(mat.length===0) tb.innerHTML = `<tr><td colspan="2" style="text-align:center;">Nessun voto</td></tr>`; mat.forEach(m=>{ let v=p.voti[m][stud]||'-'; tb.innerHTML+=`<tr><td style="font-size:15px;"><b>${m}</b></td><td><b class="${v!=='-'?calcolaColore(v):''}" style="font-size:16px;">${v}</b></td></tr>`; }); } cambiaPagina('voti-studente-pagella'); }
    </script>
</body>
</html>
