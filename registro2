<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro Elettronico CyberDark Cloud</title>
    
    <script src="https://www.gstatic.com/firebasejs/10.11.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.11.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.11.0/firebase-database-compat.js"></script>

    <style>
        :root {
            --bg-black: #000000;
            --bg-card: #121214;
            --bg-sidebar: #0a0a0c;
            --border-color: #262626;
            --text-light: #f4f4f5;
            --text-muted: #a1a1aa;
            
            --accent-purple: #a855f7;
            --accent-cyan: #06b6d4;
            
            --voto-suff: #4ade80;
            --voto-insuff: #f87171;

            --c-presente: rgba(16, 185, 129, 0.15); --t-presente: #4ade80;
            --c-assente: rgba(239, 68, 68, 0.15); --t-assente: #f87171;
            --c-ritardo: rgba(249, 115, 22, 0.15); --t-ritardo: #f97316;
            --c-uscito: rgba(59, 130, 246, 0.15); --t-uscito: #3b82f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, sans-serif; }

        body { display: flex; height: 100vh; background-color: var(--bg-black); color: var(--text-light); overflow: hidden; }

        #btn-toggle-menu { position: absolute; top: 15px; left: 15px; z-index: 1000; background: var(--bg-card); border: 1px solid var(--border-color); color: white; padding: 10px 14px; font-size: 18px; border-radius: 8px; cursor: pointer; transition: 0.2s; }
        #btn-toggle-menu:hover { border-color: var(--accent-cyan); }

        .sidebar { width: 260px; background-color: var(--bg-sidebar); padding: 70px 15px 25px 15px; display: flex; flex-direction: column; border-right: 1px solid var(--border-color); overflow-y: auto; transition: transform 0.3s ease; position: absolute; height: 100%; z-index: 900; }
        .sidebar.nascosta { transform: translateX(-100%); }
        .sidebar h2 { margin-bottom: 20px; font-size: 20px; text-align: center; color: var(--accent-purple); font-weight: 800; }
        .nav-btn { background: none; border: none; color: var(--text-muted); padding: 12px 15px; text-align: left; font-size: 14px; cursor: pointer; border-radius: 8px; margin-bottom: 5px; transition: all 0.2s ease; display: flex; align-items: center; gap: 10px; width: 100%; font-weight: 600; }
        .nav-btn:hover { background-color: #18181b; color: var(--text-light); }
        .nav-btn.active { background-color: var(--accent-purple); color: white; box-shadow: 0 4px 14px rgba(168, 85, 247, 0.4); }

        .main-content { flex: 1; padding: 70px 40px 40px 40px; overflow-y: auto; transition: margin-left 0.3s ease; margin-left: 260px; }
        .main-content.allargato { margin-left: 0; }
        
        .page { display: none; }
        .page.active { display: block; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        h1 { margin-bottom: 25px; font-size: 26px; font-weight: 700; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .card { background: var(--bg-card); border-radius: 12px; padding: 20px; margin-bottom: 20px; border: 1px solid var(--border-color); overflow-x: auto; }
        
        input, select, textarea { padding: 10px; background-color: #1c1c1f; border: 1px solid var(--border-color); border-radius: 8px; font-size: 14px; color: white; width: 100%; margin-bottom: 15px; }
        input[type="checkbox"] { width: auto; margin-bottom: 0; transform: scale(1.2); cursor: pointer; margin-right: 8px; }
        input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent-cyan); }
        
        .btn { background-color: var(--accent-cyan); color: black; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 700; transition: 0.2s; }
        .btn:hover { opacity: 0.9; transform: scale(0.98); }
        .btn-danger { background-color: #ef4444; color: white; }
        .btn-success { background-color: #10b981; color: white; }
        .btn-small { padding: 5px 10px; font-size: 12px; }
        .btn-cestino { background: transparent; border: none; font-size: 16px; cursor: pointer; padding: 5px; }
        .btn-cestino:hover { transform: scale(1.2); }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; min-width: 600px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
        th { background-color: #18181b; color: var(--text-muted); font-size: 13px; text-transform: uppercase; }

        .clickable-name { color: var(--accent-cyan); cursor: pointer; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

        .row-Presente { background-color: var(--c-presente); border-left: 4px solid var(--t-presente); }
        .row-Assente { background-color: var(--c-assente); border-left: 4px solid var(--t-assente); }
        .row-Ritardo { background-color: var(--c-ritardo); border-left: 4px solid var(--t-ritardo); }
        .row-Uscito { background-color: var(--c-uscito); border-left: 4px solid var(--t-uscito); }
        select.select-stato { background-color: #18181b; border: 1px solid rgba(255,255,255,0.1); color: inherit; width: auto; margin: 0; font-weight: bold; }

        .voto-item { display: inline-block; margin-right: 6px; font-weight: bold; cursor: pointer; padding: 4px 8px; border-radius: 6px; border: 1px solid transparent; }
        .voto-item:hover { border-color: rgba(255,255,255,0.3); transform: translateY(-2px); }
        .voto-verde { background: rgba(74, 222, 128, 0.1); color: var(--voto-suff); }
        .voto-rosso { background: rgba(248, 113, 113, 0.1); color: var(--voto-insuff); }
        .voto-no-media { background: rgba(6, 182, 212, 0.15) !important; color: #22d3ee !important; border: 1px dashed #06b6d4 !important; }
        .voto-A { background: transparent !important; color: #ef4444 !important; border: none !important; }
        .voto-IMP { background: rgba(59, 130, 246, 0.2) !important; color: #3b82f6 !important; border: 1px solid #3b82f6 !important; }

        .grid-materie { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
        .card-materia { background: var(--bg-card); border: 1px solid var(--border-color); padding: 20px; border-radius: 10px; text-align: center; cursor: pointer; font-weight: bold; transition: 0.2s; position: relative; }
        .card-materia:hover { border-color: var(--accent-cyan); background: #18181b; }

        .dash-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .dash-box { background: #18181b; padding: 15px; border-radius: 10px; border: 1px solid var(--border-color); }
        .dash-box h4 { color: var(--accent-purple); margin-bottom: 10px; font-size: 15px; }

        .modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); align-items: center; justify-content: center; }
        .modal.active { display: flex; }
        .modal-content { background-color: var(--bg-card); border: 1px solid var(--border-color); padding: 25px; border-radius: 12px; width: 500px; max-height: 85vh; overflow-y: auto; position: relative; }
        .close-modal { position: absolute; top: 15px; right: 20px; font-size: 24px; color: var(--text-muted); cursor: pointer; }
        
        #sync-status { text-align: center; font-size: 12px; color: var(--text-muted); margin-top: 10px; }
        .status-ok { color: #10b981 !important; }
        
        .stats-details { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
        
        .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: #18181b; padding: 15px; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 15px; max-height: 200px; overflow-y: auto; }
        .checkbox-item { display: flex; align-items: center; font-size: 14px; }
        
        .card-studente-archivio { padding: 12px; background: #1c1c1f; border-radius: 8px; border: 1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center; cursor:pointer; transition: 0.2s; }
        .card-studente-archivio:hover { border-color: var(--accent-cyan); background: #27272a; }

        .stud-row-voto:hover { background-color: #1c1c1f; }
        .click-stats:hover { color: var(--accent-cyan) !important; }

        /* Schermata di Login CyberDark */
        #login-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg-black); display: flex; align-items: center; justify-content: center; z-index: 10000; flex-direction: column; }
        .login-box { background: var(--bg-card); border: 1px solid var(--border-color); padding: 40px; border-radius: 12px; width: 90%; max-width: 380px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        .login-box input[type="text"], .login-box input[type="password"], .login-box input[type="email"] { width: 100%; padding: 12px; margin: 10px 0; background: #18181b; border: 1px solid var(--border-color); color: var(--text-light); border-radius: 6px; outline: none; font-size: 16px; box-sizing: border-box; }
        .login-box input:focus { border-color: var(--accent-purple); }
        .login-box button { width: 100%; padding: 12px; background: var(--accent-purple); border: none; color: white; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 16px; margin-top: 5px; transition: 0.2s; }
        .login-box button:hover { background: #9333ea; }
        .login-box .btn-reg { background: #27272a; margin-top: 15px; color: var(--text-muted); font-size: 14px; }
        .login-box .btn-reg:hover { background: #3f3f46; color: white; }
    </style>
</head>
<body>

    <div id="login-overlay">
        <div class="login-box">
            <h2 style="color: var(--accent-cyan); margin-bottom: 5px; font-size: 24px;">CyberDark Cloud</h2>
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 20px;">Accedi al Registro Elettronico</p>
            <input type="text" id="login-username" placeholder="Nome Utente (es. admin)" autocomplete="username">
            <input type="password" id="login-password" placeholder="Password" autocomplete="current-password">
            
            <label style="display:flex; align-items:center; color:var(--text-muted); font-size:14px; margin: 10px 0; cursor:pointer;">
                <input type="checkbox" id="ricorda-pwd" checked style="margin-right:8px; width:auto; transform:scale(1);"> Mantenimi Collegato
            </label>

            <button onclick="effettuaLogin()">Accedi</button>
            <button class="btn-reg" onclick="effettuaRegistrazione()">Nuovo Insegnante? Registrati</button>
            <p id="login-error" style="color: var(--voto-insuff); margin-top: 15px; font-size: 14px; min-height: 20px;"></p>
        </div>
    </div>

    <button id="btn-toggle-menu" onclick="toggleSidebar()">☰ Menu</button>

    <div class="sidebar" id="sidebar">
        <h2>CYBERDARK</h2>
        
        <div style="padding: 0 15px; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
            <span style="font-size:12px; color:var(--accent-cyan); font-weight:bold;">CLASSE SELEZIONATA:</span>
            <select id="selettore-classe" onchange="cambiaClasseCorrente(this.value)" style="width:100%; margin:5px 0 0 0; padding:8px; background:#18181b; border:1px solid var(--accent-purple);"></select>
        </div>

        <button id="btn-dashboard" class="nav-btn active" onclick="cambiaPagina('dashboard', this)">🏠 Dashboard</button>
        <button id="btn-presenze" class="nav-btn" onclick="cambiaPagina('presenze', this)">📅 Appello</button>
        <button id="btn-voti" class="nav-btn" onclick="cambiaPagina('voti', this)">📚 Voti</button>
        <button id="btn-attivita" class="nav-btn" onclick="cambiaPagina('attivita', this)">📝 Attività</button>
        <button id="btn-compiti" class="nav-btn" onclick="cambiaPagina('compiti', this)">🎒 Compiti</button>
        <button id="btn-note" class="nav-btn" onclick="cambiaPagina('note', this)">⚠️ Note</button>
        <button id="btn-comunicazioni" class="nav-btn" onclick="cambiaPagina('comunicazioni', this)">📢 Comunicazioni</button>
        <div style="margin: 15px 0; border-top: 1px solid var(--border-color);"></div>
        <button id="btn-crea-pagella" class="nav-btn" onclick="cambiaPagina('crea-pagella', this)">✍️ Crea Pagella</button>
        <button id="btn-pagelle" class="nav-btn" onclick="cambiaPagina('pagelle', this)">📁 Archivio Pagelle</button>
        <div style="margin: auto 0 10px 0;"></div>
        <button id="btn-config" class="nav-btn" onclick="cambiaPagina('config', this)">⚙️ Impostazioni</button>
        <button id="btn-logout" class="nav-btn" onclick="effettuaLogout()">🚪 Esci</button>
        <div id="sync-status">Connessione... ⏳</div>
    </div>

    <div class="main-content" id="main-content">
        <div id="page-dashboard" class="page active">
            <h1>Riepilogo del Giorno <input type="date" id="dataGlobale" style="max-width: 200px; margin: 0; display: inline-block;" onchange="cambiaDataGlobale(this.value)"></h1>
            <div class="dash-grid">
                <div class="dash-box">
                    <h4>📊 Presenze, Assenze e Ritardi (<span id="dash-data-oggi"></span>)</h4>
                    <ul id="dash-assenti" style="list-style: none; font-size: 14px; line-height: 1.6;"></ul>
                </div>
                <div class="dash-box">
                    <h4>⚠️ Eventi da Giustificare</h4>
                    <ul id="dash-giustificazioni" style="list-style: none; font-size: 14px; line-height: 1.6;"></ul>
                </div>
                <div class="dash-box">
                    <h4>🎒 Compiti in Scadenza Oggi</h4>
                    <ul id="dash-compiti" style="list-style: none; color: var(--text-muted); font-size: 14px; line-height: 1.6;"></ul>
                </div>
                <div class="dash-box">
                    <h4>📝 Attività Svolte Oggi</h4>
                    <ul id="dash-attivita" style="list-style: none; color: var(--text-muted); font-size: 14px; line-height: 1.6;"></ul>
                </div>
                <div class="dash-box">
                    <h4>📢 Ultime Comunicazioni</h4>
                    <div id="dash-comunicazioni" style="color: var(--text-muted); font-size: 14px;"></div>
                </div>
            </div>
        </div>

        <div id="page-presenze" class="page">
            <h1 style="align-items: flex-start;">
                Appello Giornaliero 
                <button class="btn btn-success" onclick="salvaPresenzeConAvviso()">💾 Salva Presenze</button>
            </h1>
            <div class="card">
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 15px; background: #1c1c1f; padding: 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <input type="date" id="dataAppello" style="max-width: 150px; margin:0;" onchange="caricaAppello()">
                    <span style="color:var(--text-muted); font-size:14px; font-weight:bold;">Orario:</span>
                    <input type="time" id="oraInizioAppello" style="max-width: 100px; margin:0; padding:6px;" onchange="salvaInfoAppello()">
                    <span style="color:var(--text-muted);">-</span>
                    <input type="time" id="oraFineAppello" style="max-width: 100px; margin:0; padding:6px;" onchange="salvaInfoAppello()">
                    <button class="btn btn-small" style="background:var(--accent-purple); color:white;" onclick="impostaOraAttualeAppello()">🕒 Inserisci Ora Attuale</button>
                </div>
                <table>
                    <thead><tr><th>Studente e Statistiche</th><th>Stato e Orario Specifico</th></tr></thead>
                    <tbody id="tabellaPresenze"></tbody>
                </table>
            </div>
        </div>

        <div id="page-voti" class="page">
            <h1>Registro Valutazioni</h1>
            <div id="grigliaMaterieVoti" class="grid-materie"></div>
        </div>

        <div id="page-dettaglio-voti" class="page">
            <h1 id="titoloMateriaVoti" style="margin-bottom: 10px;">Materia</h1>
            <div style="display:flex; gap:10px; margin-bottom: 20px;">
                <button class="btn" style="background:#27272a; color:white;" onclick="cambiaPagina('voti', document.getElementById('btn-voti'))">⬅ Indietro</button>
                <button id="btn-toggle-multiplo" class="btn" onclick="attivaVotoMultiplo()">➕ Aggiungi Voto Multiplo</button>
                <button id="btn-voti-classe" class="btn btn-success" onclick="attivaVotiClasse()">📋 Inserisci Voti alla Classe</button>
            </div>
            
            <div id="panel-voto-multiplo" style="display:none; background:#18181b; padding:20px; border-radius:10px; border:1px solid var(--accent-purple); margin-bottom:20px;">
                <h4 style="margin-bottom:10px; color:var(--accent-purple);">Seleziona gli studenti dalla tabella e inserisci il voto per tutti:</h4>
                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items: center;">
                    <input type="text" id="votoValMultiplo" placeholder="Voto" style="width:120px; margin:0;">
                    <input type="date" id="votoDataMultiplo" style="width:180px; margin:0;">
                    <select id="votoTipoMultiplo" style="width:150px; margin:0;"><option value="Orale">Orale</option><option value="Scritto">Scritto</option><option value="Pratico">Pratico</option></select>
                    <input type="text" id="votoCommentoMultiplo" placeholder="Commento" style="width:150px; margin:0;">
                    <label class="checkbox-item" style="margin:0;"><input type="checkbox" id="votoFaMediaMultiplo" checked> Fa Media</label>
                </div>
                <div style="margin-top:15px; display:flex; gap:10px;">
                    <button class="btn btn-success" onclick="salvaVotoMultiplo()">💾 Salva per i selezionati</button>
                    <button class="btn btn-danger" onclick="disattivaVotoMultiplo()">Annulla</button>
                </div>
            </div>

            <div id="panel-voti-classe" style="display:none; background:#18181b; padding:20px; border-radius:10px; border:1px solid var(--accent-cyan); margin-bottom:20px;">
                <h4 style="margin-bottom:10px; color:var(--accent-cyan);">Inserisci opzioni comuni per i voti della classe:</h4>
                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items: center;">
                    <input type="date" id="votoDataClasse" style="width:180px; margin:0;" onchange="aggiornaAutoAssentiClasse()">
                    <select id="votoTipoClasse" style="width:150px; margin:0;"><option value="Orale">Orale</option><option value="Scritto">Scritto</option><option value="Pratico">Pratico</option></select>
                    <input type="text" id="votoCommentoClasse" placeholder="Commento" style="width:150px; margin:0;">
                    <label class="checkbox-item" style="margin:0;"><input type="checkbox" id="votoFaMediaClasse" checked> Fa Media</label>
                </div>
                <div style="margin-top:15px; display:flex; gap:10px;">
                    <button class="btn btn-success" onclick="salvaVotiClasse()">💾 Salva Voti Classe</button>
                    <button class="btn btn-danger" onclick="disattivaVotiClasse()">Annulla</button>
                </div>
            </div>

            <div class="card">
                <p style="color:var(--text-muted); font-size:14px; margin-bottom:15px;">🖱️ <i>Clicca direttamente sul nome dello studente per inserire un voto singolo.</i></p>
                <table>
                    <thead>
                        <tr id="thead-voti-row"></tr>
                    </thead>
                    <tbody id="corpoTabellaVoti"></tbody>
                </table>
            </div>
        </div>

        <div id="page-attivita" class="page">
            <h1>Attività Svolte</h1>
            <div class="card">
                <select id="attivitaMateria"></select>
                <input type="date" id="attivitaData" style="max-width: 220px;">
                <textarea id="attivitaTesto" rows="2" placeholder="Argomento..."></textarea>
                <button class="btn" onclick="salvaAttivita()">Registra</button>
            </div>
            <div class="card">
                <select id="filtroAttivita" onchange="caricaRegistroAttivita()"></select>
                <table><tbody id="tabellaStoricoAttivita"></tbody></table>
            </div>
        </div>

        <div id="page-compiti" class="page">
            <h1>Compiti Assegnati</h1>
            <div class="card">
                <select id="compitiMateria"></select>
                <input type="date" id="compitiData" style="max-width: 220px;">
                <textarea id="compitiTesto" rows="2" placeholder="Compiti..."></textarea>
                <button class="btn" onclick="salvaCompiti()">Assegna</button>
            </div>
            <div class="card">
                <select id="filtroCompiti" onchange="caricaRegistroCompiti()"></select>
                <table><tbody id="tabellaStoricoCompiti"></tbody></table>
            </div>
        </div>

        <div id="page-note" class="page">
            <h1>Note Disciplinari e Generiche</h1>
            <div class="card">
                <div style="margin-bottom: 10px;"><b>Seleziona Studenti:</b></div>
                <label class="checkbox-item" style="margin-bottom:10px;"><input type="checkbox" onchange="selezionaTuttiNote(this.checked)"> <b style="color:var(--accent-purple);">Tutta la classe</b></label>
                <div id="noteCheckboxes" class="checkbox-grid"></div>

                <select id="notaTipo" style="max-width: 220px;">
                    <option value="Generica">📌 Nota Generica</option>
                    <option value="Disciplinare">⚠️ Nota Disciplinare</option>
                </select>
                <input type="date" id="notaData" style="max-width: 220px;">
                <textarea id="notaTesto" rows="2" placeholder="Motivazione della nota..."></textarea>
                <button class="btn btn-danger" onclick="salvaNota()">Salva Nota</button>
            </div>
            <div class="card">
                <table>
                    <thead><tr><th>Data</th><th>Studente</th><th>Tipo</th><th>Motivazione</th><th>Azioni</th></tr></thead>
                    <tbody id="tabellaNote"></tbody>
                </table>
            </div>
        </div>

        <div id="page-comunicazioni" class="page">
            <h1>Comunicazioni</h1>
            <div class="card">
                <input type="text" id="comTitolo" placeholder="Titolo (es. Sciopero, Uscita Anticipata)">
                <select id="comTarget" onchange="gestisciTargetComunicazione(this.value)" style="max-width: 220px;">
                    <option value="Classe">Tutta la Classe</option>
                    <option value="Solo Docente">Solo Docente</option>
                    <option value="Singolo Studente">Singolo Studente</option>
                    <option value="Più Studenti">Più Studenti</option>
                </select>
                <select id="comStudente" style="display:none; max-width: 220px;"></select>
                <div id="comPiuStudenti" class="checkbox-grid" style="display:none; margin-top: 15px; margin-bottom: 15px;"></div>
                <input type="date" id="comData" style="max-width: 220px;">
                <textarea id="comTesto" rows="3" placeholder="Testo della comunicazione..."></textarea>
                <button class="btn" onclick="salvaComunicazione()">Pubblica</button>
            </div>
            <div class="card">
